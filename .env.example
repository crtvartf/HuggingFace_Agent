# Copy to .env and fill in. Never commit .env.

# Required for running the agent
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Local eval: HF token (read scope) after accepting https://huggingface.co/datasets/gaia-benchmark/GAIA
HF_TOKEN=

# Submission: your HF username and the public URL of this repo's code
HF_USERNAME=
AGENT_CODE_URL=

# Stop a run once it has spent this much on OpenRouter (USD)
MAX_RUN_USD=2.0
